# Manejo automático de saltos de línea
* text=auto eol=lf

# HTML, CSS, JS
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows-specific
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios (no aplicar conversión)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.ttf binary
*.woff binary
*.woff2 binary

# GeoJSON (texto pero grande)
*.geojson text eol=lf
